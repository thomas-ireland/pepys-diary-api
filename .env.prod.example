# Copy to .env on the server -- never commit the real one. This is the only
# secret docker-compose.prod.yml needs; it builds DATABASE_URL from it
# directly, so the app and Postgres always agree.
POSTGRES_PASSWORD="generate-a-long-random-password"

# uid/gid of the dedicated, unprivileged system account Caddy runs as --
# never your own admin user. See CLAUDE.md's Deployment section for how to
# create it; then run `id -u pepys-app` / `id -g pepys-app` and paste the
# results here.
CADDY_UID="run id -u pepys-app on the server and put the result here"
CADDY_GID="run id -g pepys-app on the server and put the result here"
