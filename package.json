{
  "name": "pepys-diary-api",
  "version": "0.0.0",
  "description": "The Diary of Samuel Pepys API.",
  "license": "MIT",
  "author": "Thomas Ireland",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build:data": "npm run build && node dist/ingest/build.js",
    "gate": "npm ci && npm run lint && npm run format:check && npm run test && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
